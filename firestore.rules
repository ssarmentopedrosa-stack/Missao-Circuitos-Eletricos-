rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Authoritative Games Session Collection: games/{uid}
    // Students have READ-ONLY permission to their own game session.
    // WRITE is strictly forbidden from client - ONLY Server Admin SDK may write!
    match /games/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // STRICT SERVER AUTHORITY ONLY

      // Attempts Subcollection: games/{uid}/attempts/{attemptId}
      // Students have READ-ONLY permission to their own attempts.
      // WRITE is strictly forbidden from client - ONLY Server Admin SDK may write!
      match /attempts/{attemptId} {
        allow read: if isOwner(uid);
        allow write: if false; // STRICT SERVER AUTHORITY ONLY
      }
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
